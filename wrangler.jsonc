{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmo-trading-calendar",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "triggers": {
    // Every minute: reminder sender + heartbeat. Saturdays 07:00 UTC: weekly
    // health-check + full backup email (see worker/index.js scheduled()).
    // Day-of-week as the name "SAT" — a bare 6 is rendered as Friday by the
    // Cloudflare dashboard, so the explicit name avoids that ambiguity.
    "crons": ["* * * * *", "0 7 * * SAT"]
  }
}
